{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScaleVision numeric vision tool contract",
  "type": "object",
  "properties": {
    "name": { "const": "vision_read_number" },
    "description": {
      "const": "Lee un único valor numérico visible en una captura de cámara sin inferir dígitos ilegibles."
    },
    "parameters": {
      "type": "object",
      "required": ["capture_id"],
      "properties": {
        "capture_id": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string" }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["tool", "capture_id", "status", "number", "raw_text", "reason"],
      "properties": {
        "tool": { "const": "vision_read_number" },
        "capture_id": { "type": "string" },
        "status": { "enum": ["READ", "NOT_LEGIBLE", "CONFLICT"] },
        "number": { "type": ["string", "null"] },
        "raw_text": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "required": ["name", "description", "parameters", "result"],
  "additionalProperties": false
}
