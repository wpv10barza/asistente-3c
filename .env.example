GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SPREADSHEET_ID=
SHEET_NAME=Data
HEADER_ROW=4
PORT=3000

# Generate a long random value and use the same value in
# esp32-3C/include/local_config.h. Never commit the real token.
ESP32_API_TOKEN=
ALLOW_INSECURE_DEVICE_API=false

# Local-network discovery for ESP32 devices.
MDNS_ENABLED=true
MDNS_REQUIRED=false
MDNS_SERVICE=3c
MDNS_HOST=3c-backend.local
MDNS_NAME=3C Backend
